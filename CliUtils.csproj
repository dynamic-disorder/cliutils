<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1605</WarningsNotAsErrors>
    <RootNamespace>CliUtils</RootNamespace>
    <AssemblyName>CliUtils</AssemblyName>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Reproducible build with redacted paths. Both properties are needed and neither is the
         SDK default: without them the assembly embeds the build machine's absolute PDB path in its
         CodeView debug record, and that path then ships inside the published package. The build
         itself is deterministic already; what was missing was path redaction.
           Deterministic                 same inputs produce a byte-identical assembly
           ContinuousIntegrationBuild    deterministic *source* paths, so the PDB carries no layout
           PathMap                       maps the checkout root to a fixed placeholder
         Verify after packing: no absolute path may survive in the DLL. See PUBLISHING.md. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>

    <!-- NuGet package metadata. The id is prefixed because plain `CliUtils` is taken on
         nuget.org; the version is bumped deliberately per release. -->
    <PackageId>DynamicDisorder.CliUtils</PackageId>
    <Version>0.1.1</Version>
    <Authors>dynamic-disorder</Authors>
    <Description>Shared console output utilities for CLI applications: colored output helpers, Spectre.Console wrappers, and an in-memory logger.</Description>
    <PackageTags>console;cli;spectre;logging</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/dynamic-disorder/cliutils</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
  </ItemGroup>

</Project>
